/* ========== 언어 전환 함수 ========== */
let currentLang = 'ko';

function switchLang(lang) {
    currentLang = lang;
    document.documentElement.lang = lang;
    document.body.className = 'lang-' + lang;

    /* 버튼 활성화 */
    document.querySelectorAll('.lang-btn').forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-lang') === lang);
    });

    /* 텍스트 교체 */
    const dict = T[lang];
    if (!dict) return;
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key] !== undefined) {
            el.innerHTML = dict[key];
        }
    });
}

/* 버튼 이벤트 */
document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        switchLang(this.getAttribute('data-lang'));
    });
});

/* ========== 기존 기능들 ========== */
if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
window.addEventListener('DOMContentLoaded', () => { window.scrollTo(0, 0); });

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
}, { threshold: 0.05, rootMargin: '0px 0px -50px 0px' });
document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const pe = document.getElementById('scrollProgress');
    if (pe) pe.style.width = p + '%';
});

window.addEventListener('scroll', () => {
    const nav = document.getElementById('navbar');
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 50);
});

const logo = document.getElementById('pageLogo');
const logoObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting && logo) {
            const id = entry.target.getAttribute('id');
            if (id === 'hero' || id === 'principle' || id === 'usage') {
                logo.classList.add('on-dark');
            } else {
                logo.classList.remove('on-dark');
            }
        }
    });
}, { threshold: 0.2 });
document.querySelectorAll('section[id]').forEach(s => logoObs.observe(s));

const sections = document.querySelectorAll('section[id]');
const navLinks = document.querySelectorAll('.nav-link');
const pageDots = document.querySelectorAll('.page-dot');

const sObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.2) {
            const id = entry.target.getAttribute('id');
            navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + id));
            pageDots.forEach(d => d.classList.toggle('active', d.getAttribute('data-section') === id));
        }
    });
}, { threshold: [0, 0.2, 0.5] });
sections.forEach(s => sObs.observe(s));

const smoothScrollTo = (targetId) => {
    const target = document.getElementById(targetId);
    if (target) { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
};

document.querySelectorAll('a[href^="#"], .page-dot').forEach(trigger => {
    trigger.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href') ? this.getAttribute('href').slice(1) : this.getAttribute('data-section');
        smoothScrollTo(targetId);
    });
});
</script>
