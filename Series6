<script>
    // Fade-in
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

    // Scroll Progress
    window.addEventListener('scroll', () => {
        const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
        document.getElementById('scrollProgress').style.width = p + '%';
    });

    // Nav scroll
    window.addEventListener('scroll', () => {
        document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
    });

    // Logo dark/light
    const logo = document.getElementById('pageLogo');
    const logoObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                if (id === 'hero' || id === 'principle' || id === 'usage') {
                    logo.classList.add('on-dark');
                } else {
                    logo.classList.remove('on-dark');
                }
            }
        });
    }, { threshold: 0.3 });
    document.querySelectorAll('section[id]').forEach(s => logoObs.observe(s));

    // Active nav & dots
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    const pageDots = document.querySelectorAll('.page-dot');
    const sObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + id));
                pageDots.forEach(d => d.classList.toggle('active', d.getAttribute('data-section') === id));
            }
        });
    }, { threshold: 0.3 });
    sections.forEach(s => sObs.observe(s));

    pageDots.forEach(d => d.addEventListener('click', () => {
        document.getElementById(d.getAttribute('data-section')).scrollIntoView({ behavior: 'smooth' });
    }));
    navLinks.forEach(l => l.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById(l.getAttribute('href').slice(1)).scrollIntoView({ behavior: 'smooth' });
    }));
</script>

