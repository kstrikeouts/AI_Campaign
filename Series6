<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chain of Thought (CoT) 프롬프팅 핸드북</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --apple-blue: #0071e3;
            --apple-gray-1: #1d1d1f;
            --apple-gray-2: #6e6e73;
            --apple-gray-3: #86868b;
            --apple-gray-4: #d2d2d7;
            --apple-gray-5: #f5f5f7;
            --apple-bg: #fbfbfd;
        }

        html { scroll-behavior: smooth; }

        body {
            background: var(--apple-bg);
            color: var(--apple-gray-1);
            letter-spacing: -0.01em;
            overflow-x: hidden;
            font-size: 20px;
        }

        /* ======================== */
        /* ★ LOGO — 위치 내림 (top: 80px) */
        /* ======================== */
        .page-logo {
            position: fixed;
            top: 80px;
            right: 36px;
            z-index: 10000;
            height: 38px;
            width: auto;
            opacity: 0.85;
            transition: all 0.3s ease;
            pointer-events: none;
        }

        .page-logo.on-dark {
            filter: brightness(0) invert(1);
            opacity: 0.7;
        }

        /* === NAV === */
        .glass-nav {
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            background: rgba(251, 251, 253, 0.72);
            border-bottom: 0.5px solid rgba(0, 0, 0, 0.08);
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 9999;
            transition: all 0.3s ease;
        }

        .glass-nav.scrolled {
            background: rgba(251, 251, 253, 0.92);
            box-shadow: 0 1px 12px rgba(0, 0, 0, 0.04);
        }

        .nav-link {
            color: var(--apple-gray-2);
            font-size: 1.05rem;
            font-weight: 500;
            transition: color 0.25s ease;
            position: relative;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px; left: 50%;
            width: 0; height: 1.5px;
            background: var(--apple-blue);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover { color: var(--apple-gray-1); }
        .nav-link:hover::after { width: 100%; }
        .nav-link.active { color: var(--apple-gray-1); }
        .nav-link.active::after { width: 100%; }

        /* === HERO === */
        .hero-section {
            background: #000000;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .hero-gradient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.35;
            animation: orbFloat 20s ease-in-out infinite;
        }

        .orb-1 {
            width: 600px; height: 600px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            top: -200px; right: -100px;
        }
        .orb-2 {
            width: 500px; height: 500px;
            background: linear-gradient(135deg, #f093fb, #f5576c);
            bottom: -200px; left: -100px;
            animation-delay: -7s;
        }
        .orb-3 {
            width: 400px; height: 400px;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: -14s;
        }

        @keyframes orbFloat {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(30px, -40px) scale(1.05); }
            50% { transform: translate(-20px, 20px) scale(0.95); }
            75% { transform: translate(40px, 30px) scale(1.02); }
        }

        /* ★ Vol Badge — 위치 내림 (top: 80px), 글씨 키움 */
        .vol-badge {
            position: absolute;
            top: 80px;
            left: 42px;
            z-index: 20;
        }

        .vol-badge-inner {
            display: inline-flex;
            align-items: center;
            gap: 0;
            padding: 14px 28px;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.14);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .vol-badge-text {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            background: linear-gradient(135deg, #ffd60a 0%, #ff9f0a 40%, #ff375f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Hero Title */
        .hero-title-main {
            font-size: 5.8rem;
            font-weight: 900;
            letter-spacing: -0.05em;
            line-height: 1.05;
            background: linear-gradient(135deg, #ffffff 0%, #c7c7cc 25%, #ffffff 50%, #a8a8ad 75%, #ffffff 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShiftSlow 8s ease-in-out infinite;
        }

        .hero-title-sub {
            font-size: 2.2rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            background: linear-gradient(90deg, #86868b, #a1a1a6, #86868b);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShiftSlow 6s ease-in-out infinite;
        }

        .hero-tagline {
            font-size: 2rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.4;
            background: linear-gradient(135deg, #5ac8fa 0%, #64d2ff 30%, #bf5af2 60%, #ff375f 100%);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShiftSlow 10s ease-in-out infinite;
        }

        @keyframes gradientShiftSlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .hero-badge-pill {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            color: #a1a1a6;
        }

        /* === SECTION TITLES === */
        .section-title {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1.1;
        }

        .gradient-text-blue {
            background: linear-gradient(135deg, #0071e3 0%, #5ac8fa 50%, #0071e3 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 6s ease-in-out infinite;
        }
        .gradient-text-purple {
            background: linear-gradient(135deg, #5e5ce6 0%, #bf5af2 50%, #5e5ce6 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 6s ease-in-out infinite;
        }
        .gradient-text-cyan {
            background: linear-gradient(135deg, #64d2ff 0%, #5e5ce6 50%, #64d2ff 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 6s ease-in-out infinite;
        }
        .gradient-text-teal {
            background: linear-gradient(135deg, #30d158 0%, #64d2ff 50%, #0071e3 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 6s ease-in-out infinite;
        }
        .gradient-text-green {
            background: linear-gradient(135deg, #30d158 0%, #34c759 50%, #00c7be 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 6s ease-in-out infinite;
        }
        .gradient-text-red {
            background: linear-gradient(135deg, #ff453a 0%, #ff6961 40%, #ff9500 100%);
            background-size: 200% 200%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 6s ease-in-out infinite;
        }
        .gradient-text-summary {
            background: linear-gradient(135deg, #0071e3 0%, #5e5ce6 33%, #bf5af2 66%, #0071e3 100%);
            background-size: 300% 300%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 8s ease-in-out infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .section-subtitle {
            font-size: 1.55rem;
            font-weight: 400;
            line-height: 1.6;
            color: var(--apple-gray-2);
        }

        /* === CARDS === */
        .glass-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 0, 0, 0.06);
            border-radius: 24px;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
            border-color: rgba(0, 0, 0, 0.1);
        }

        .dark-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .dark-card:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.14);
            transform: translateY(-4px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        /* === TEXT SIZE CLASSES === */
        .card-heading { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; }
        .card-body { font-size: 1.125rem; line-height: 1.75; }
        .label-sm { font-size: 1rem; font-weight: 600; letter-spacing: 0.02em; }
        .text-2xs { font-size: 0.95rem; }
        .sub-heading { font-size: 1.125rem; font-weight: 700; }
        .sub-body { font-size: 1.05rem; line-height: 1.75; }
        .text-tiny { font-size: 1rem; }
        .dark-subtitle { font-size: 1.375rem; font-weight: 400; line-height: 1.6; color: #86868b; }

        /* === TYPE BADGE === */
        .type-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 14px; border-radius: 100px;
            font-size: 1rem; font-weight: 600;
        }

        /* === CODE BLOCK === */
        .code-block {
            background: #1d1d1f;
            border-radius: 16px;
            padding: 28px 32px;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 1.1rem;
            line-height: 1.85;
            color: #e5e5ea;
            overflow-x: auto;
        }
        .code-block .prompt-label {
            color: #86868b; font-size: 0.95rem;
            text-transform: uppercase; letter-spacing: 0.1em;
            display: block; margin-bottom: 12px;
        }
        .code-block .highlight { color: #64d2ff; }
        .code-block .string { color: #ffd60a; }
        .code-block .comment { color: #636366; }

        .code-sm { font-size: 1.05rem !important; padding: 20px 24px !important; }

        /* === PILL === */
        .pill {
            display: inline-block; padding: 8px 18px; border-radius: 100px;
            font-size: 1.05rem; font-weight: 500;
        }
        .pill-blue { background: rgba(0, 113, 227, 0.08); color: #0071e3; }
        .pill-green { background: rgba(52, 199, 89, 0.08); color: #248a3d; }
        .pill-red { background: rgba(255, 59, 48, 0.08); color: #d70015; }
        .pill-purple { background: rgba(175, 82, 222, 0.08); color: #8944ab; }

        /* === TIMELINE === */
        .timeline-item { position: relative; padding-left: 36px; }
        .timeline-item::before {
            content: ''; position: absolute; left: 0; top: 0; bottom: 0;
            width: 2px; background: linear-gradient(180deg, var(--apple-blue), rgba(0,113,227,0.1));
        }
        .timeline-item::after {
            content: ''; position: absolute; left: -5px; top: 8px;
            width: 12px; height: 12px; border-radius: 50%;
            background: var(--apple-blue); box-shadow: 0 0 0 4px rgba(0,113,227,0.15);
        }

        /* === PAGE INDICATOR === */
        .page-indicator {
            position: fixed; right: 32px; top: 50%; transform: translateY(-50%);
            z-index: 9998; display: flex; flex-direction: column; gap: 12px;
        }
        .page-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--apple-gray-4); transition: all 0.3s ease; cursor: pointer;
        }
        .page-dot.active {
            background: var(--apple-blue); transform: scale(1.4);
            box-shadow: 0 0 0 3px rgba(0,113,227,0.2);
        }
        .page-dot:hover { background: var(--apple-gray-3); transform: scale(1.2); }

        /* === SCROLL PROGRESS === */
        .scroll-progress {
            position: fixed; top: 0; left: 0; height: 2px;
            background: linear-gradient(90deg, #0071e3, #64d2ff);
            z-index: 99999; transition: width 0.1s linear;
        }

        /* === FLOW === */
        .flow-arrow { color: #48484a; font-size: 1.6rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .flow-step {
            border-radius: 16px; padding: 16px 20px; text-align: center;
            font-size: 1.1rem; font-weight: 600; flex: 1; min-width: 0; transition: all 0.3s ease;
        }
        .flow-step:hover { transform: scale(1.03); }

        /* === CAUTION BOX === */
        .caution-box {
            background: linear-gradient(135deg, rgba(255,59,48,0.04), rgba(255,149,0,0.04));
            border: 1px solid rgba(255,59,48,0.12);
            border-radius: 20px; position: relative; overflow: hidden;
        }
        .caution-box::before {
            content: ''; position: absolute; top: 0; left: 0;
            width: 4px; height: 100%; background: linear-gradient(180deg, #ff3b30, #ff9500);
        }

        /* === SUMMARY CARD === */
        .summary-grid-item {
            background: #ffffff; border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.05); padding: 28px;
            transition: all 0.4s ease;
        }
        .summary-grid-item:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.06); transform: translateY(-2px); }

        /* === NUM HIGHLIGHT === */
        .num-highlight {
            font-size: 4.5rem; font-weight: 800; letter-spacing: -0.05em; line-height: 1;
            background: linear-gradient(135deg, #0071e3, #64d2ff);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        /* === ICON CIRCLE === */
        .icon-circle {
            width: 56px; height: 56px; border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; flex-shrink: 0;
        }

        /* === ANIMATIONS === */
        .fade-in { opacity: 0; transform: translateY(40px); transition: all 0.8s cubic-bezier(0.25,0.46,0.45,0.94); }
        .fade-in.visible { opacity: 1; transform: translateY(0); }
        .fade-in-delay-1 { transition-delay: 0.1s; }
        .fade-in-delay-2 { transition-delay: 0.2s; }
        .fade-in-delay-3 { transition-delay: 0.3s; }
        .fade-in-delay-4 { transition-delay: 0.4s; }
        .fade-in-delay-5 { transition-delay: 0.5s; }

        /* === FOOTER === */
        .footer-section { background: #1d1d1f; }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--apple-gray-4); border-radius: 4px; }

        /* === EXAMPLE PROMPT IN TYPE CARDS === */
        .example-prompt-box {
            background: #1d1d1f;
            border-radius: 12px;
            padding: 16px 20px;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.95rem;
            line-height: 1.7;
            color: #e5e5ea;
        }
        .example-prompt-box .ep-label {
            font-size: 0.8rem;
            color: #86868b;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 8px;
            display: block;
            font-family: 'Inter', sans-serif;
        }
        .example-prompt-box .ep-highlight { color: #64d2ff; }
        .example-prompt-box .ep-string { color: #ffd60a; }

        @media print {
            .glass-nav, .page-indicator, .scroll-progress, .page-logo { display: none !important; }
            .hero-section { min-height: auto; padding: 60px 0; }
            body { background: #fff; }
        }
    </style>
</head>
